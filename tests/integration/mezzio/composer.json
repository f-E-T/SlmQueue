{
    "require": {
        "fet/queue": "*",
        "mezzio/mezzio": "^3.23",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-config-aggregator": "^1.19"
    },
    "repositories": [
        {
            "type": "path",
            "url": "lib/"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "App\\": "src/App/",
